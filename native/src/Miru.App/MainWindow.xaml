<Window x:Class="Miru.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Miru.Core" Title="MIRU">
  <Grid x:Name="Shell" Background="{ThemeResource MiruCanvas}" Loaded="Shell_Loaded">
    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{ThemeResource MiruSidebar}" BorderBrush="{ThemeResource MiruBorder}" BorderThickness="0,0,0,1">
      <Grid Padding="12,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button x:Name="HomeButton" Content="MIRU" FontSize="18" FontWeight="SemiBold" Style="{StaticResource QuietButton}" Click="Home_Click" AutomationProperties.Name="Home launcher" ToolTipService.ToolTip="Home launcher" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
          <RadioButton x:Name="FileMode" Content="Files" GroupName="View" IsChecked="True" Checked="FileMode_Checked" />
          <RadioButton x:Name="RepositoryMode" Content="Repository" GroupName="View" Checked="RepositoryMode_Checked" />
        </StackPanel>
        <Grid x:Name="PathControls" Grid.Column="2" MaxWidth="720" ColumnSpacing="4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox x:Name="PathInput" VerticalAlignment="Center" PlaceholderText="Open a local file or folder" AutomationProperties.Name="Local path" KeyDown="Path_KeyDown" />
          <Button x:Name="OpenPathButton" Grid.Column="1" Content="Open" VerticalAlignment="Center" Click="OpenPath_Click" />
        </Grid>
        <Button Grid.Column="3" x:Name="ThemeButton" Style="{StaticResource QuietButton}" Click="Theme_Click" AutomationProperties.Name="Toggle light and dark theme" ToolTipService.ToolTip="Toggle light / dark">
          <FontIcon Glyph="&#xE793;" FontSize="16" />
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{ThemeResource MiruSidebar}" BorderBrush="{ThemeResource MiruBorder}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="6" Margin="4,8">
          <Button x:Name="FilesRail" Style="{StaticResource QuietButton}" Click="Files_Click" AutomationProperties.Name="Files" ToolTipService.ToolTip="Files"><FontIcon Glyph="&#xE8B7;" /></Button>
          <Button x:Name="SearchRail" Style="{StaticResource QuietButton}" Click="SearchHome_Click" AutomationProperties.Name="Search HOME" ToolTipService.ToolTip="Search HOME"><FontIcon Glyph="&#xE721;" /></Button>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{ThemeResource MiruSidebar}" BorderBrush="{ThemeResource MiruBorder}" BorderThickness="0,0,1,0">
        <Grid x:Name="Explorer" Padding="8,8,8,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="EXPLORER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MiruMuted}" VerticalAlignment="Center" Margin="8,0" />
            <Button Grid.Column="1" x:Name="ParentButton" Style="{StaticResource QuietButton}" Click="Parent_Click" AutomationProperties.Name="Go to parent folder" ToolTipService.ToolTip="Parent folder"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
            <Button Grid.Column="2" x:Name="RefreshButton" Style="{StaticResource QuietButton}" Click="Refresh_Click" AutomationProperties.Name="Refresh folder" ToolTipService.ToolTip="Refresh"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
          </Grid>
          <TextBlock x:Name="TopLabel" Grid.Row="1" Margin="8,4,8,8" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MiruMuted}" FontSize="12" />
          <TreeView x:Name="FileTree" Grid.Row="2" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AllowDrop="False" AutomationProperties.Name="Files in current top" ItemInvoked="Tree_ItemInvoked" Expanding="Tree_Expanding" SelectionChanged="Tree_SelectionChanged" />
          <Button x:Name="SetTopButton" Grid.Row="3" Content="Use selected folder as top" Margin="4,8" HorizontalAlignment="Stretch" IsEnabled="False" Click="SetTop_Click" />
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource MiruBorder}" BorderThickness="0,0,0,1" Padding="20,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="DocumentTitle" Text="Home" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{ThemeResource MiruForeground}" />
            <TextBlock Grid.Column="1" Text="READ ONLY" FontSize="10" CharacterSpacing="80" Foreground="{ThemeResource MiruMuted}" Margin="12,0,0,0" />
          </Grid>
        </Border>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" />
        <Grid x:Name="HomePanel" Grid.Row="2" Padding="32,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="Your files. A quieter view." FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource MiruForeground}" />
          <TextBlock Grid.Row="1" Text="Start from HOME, or open a path above." Foreground="{ThemeResource MiruMuted}" Margin="0,8,0,20" />
          <AutoSuggestBox x:Name="HomeSearch" Grid.Row="2" PlaceholderText="Search HOME (2 or more characters)" QueryIcon="Find" QuerySubmitted="Search_Submitted" AutomationProperties.Name="Search HOME" MaxWidth="640" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,16" />
          <ListView x:Name="HomeEntries" Grid.Row="3" IsItemClickEnabled="True" ItemClick="Home_ItemClick" SelectionMode="Single" AutomationProperties.Name="Home folders and search results">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="core:ViewerEntry">
                <StackPanel Padding="8,8" Spacing="3">
                  <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource MiruForeground}" />
                  <TextBlock Text="{x:Bind RelativePath}" FontSize="12" Foreground="{ThemeResource MiruMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
        <Grid x:Name="DocumentPanel" Grid.Row="2" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel x:Name="DocumentViews" Orientation="Horizontal" Spacing="12" Padding="24,8" Visibility="Collapsed">
            <RadioButton x:Name="PreviewView" Content="Preview" GroupName="DocumentView" Checked="DocumentView_Checked" AutomationProperties.Name="Markdown preview" />
            <RadioButton x:Name="SourceView" Content="Source" GroupName="DocumentView" Checked="DocumentView_Checked" AutomationProperties.Name="Read-only Markdown source" />
            <TextBlock Text="Native Markdown · links and images inactive" Style="{StaticResource MarkdownCaption}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBox x:Name="SourceText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="13" Padding="24,20" BorderThickness="0" CornerRadius="0" Background="{ThemeResource MiruCanvas}" Foreground="{ThemeResource MiruForeground}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Read-only file source" />
          <ScrollViewer x:Name="MarkdownScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Read-only Markdown document">
            <StackPanel x:Name="MarkdownBlocks" Padding="32,24,32,48" Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch" />
          </ScrollViewer>
        </Grid>
        <StackPanel x:Name="EmptyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed" MaxWidth="520">
          <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource MiruMuted}" />
          <TextBlock x:Name="EmptyTitle" Text="Select a file" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MiruForeground}" />
          <TextBlock x:Name="EmptyDescription" Text="Browse the tree on the left. Files are never edited." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource MiruMuted}" />
        </StackPanel>
        <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="False" Visibility="Collapsed" VerticalAlignment="Top" />
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{ThemeResource MiruSidebar}" BorderBrush="{ThemeResource MiruBorder}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Local files only" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource MiruMuted}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Grid.Column="1" Text="Native preview · local, read only" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource MiruMuted}" />
      </Grid>
    </Border>
  </Grid>
</Window>
