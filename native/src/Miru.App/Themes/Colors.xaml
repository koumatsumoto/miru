<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- GitHub Primer semantic roles. High Contrast deliberately uses system colors. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MiruCanvas" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MiruSidebar" Color="#F6F8FA" />
      <SolidColorBrush x:Key="MiruForeground" Color="#1F2328" />
      <SolidColorBrush x:Key="MiruMuted" Color="#59636E" />
      <SolidColorBrush x:Key="MiruBorder" Color="#D1D9E0" />
      <SolidColorBrush x:Key="MiruAccent" Color="#0969DA" />
      <SolidColorBrush x:Key="MiruSelection" Color="#DDF4FF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="MiruCanvas" Color="#0D1117" />
      <SolidColorBrush x:Key="MiruSidebar" Color="#151B23" />
      <SolidColorBrush x:Key="MiruForeground" Color="#F0F6FC" />
      <SolidColorBrush x:Key="MiruMuted" Color="#9198A1" />
      <SolidColorBrush x:Key="MiruBorder" Color="#3D444D" />
      <SolidColorBrush x:Key="MiruAccent" Color="#4493F8" />
      <SolidColorBrush x:Key="MiruSelection" Color="#132F4C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="MiruCanvas" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiruSidebar" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MiruForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiruMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiruBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MiruAccent" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="MiruSelection" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="QuietButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <!-- Fixed native presentation styles. No document content is loaded as XAML. -->
  <Style x:Key="MarkdownText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource MiruForeground}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>
  <Style x:Key="MarkdownCode" TargetType="TextBlock" BasedOn="{StaticResource MarkdownText}">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="MarkdownCaption" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource MiruMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="MarkdownSurface" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource MiruSidebar}" />
    <Setter Property="BorderBrush" Value="{ThemeResource MiruBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="MarkdownQuote" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource MiruBorder}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="16,0,0,0" />
  </Style>
  <Style x:Key="MarkdownHeadingBorder" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource MiruBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,8" />
  </Style>
  <Style x:Key="MarkdownTableCell" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource MiruBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style x:Key="MarkdownTableHeader" TargetType="Border" BasedOn="{StaticResource MarkdownTableCell}">
    <Setter Property="Background" Value="{ThemeResource MiruSidebar}" />
  </Style>
  <Style x:Key="MarkdownRule" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource MiruBorder}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
</ResourceDictionary>
