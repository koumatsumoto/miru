{
  "name": "@koumatsumoto/miru",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only local file and Git viewer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koumatsumoto/miru.git"
  },
  "bin": {
    "ev": "dist/cli.mjs",
    "miru": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp build --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "test:browser": "python tests/browser.py",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@mermaid-js/tiny": "12.3.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/primitive": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "@types/node": "24.12.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "tm-grammars": "1.32.22",
    "tm-themes": "1.12.12",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
